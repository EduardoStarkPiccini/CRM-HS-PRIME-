# ==========================================================
# CRM HS PRIME — Variáveis de ambiente
# Copie este arquivo para .env.local (desenvolvimento) e
# configure as mesmas chaves nas Environment Variables da Vercel.
# ==========================================================

# URL do projeto Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=

# Chave pública "anon" (Project Settings > API)
# Pode ser exposta no frontend — é protegida pelas políticas de RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave "service_role" (Project Settings > API)
# NUNCA prefixar com NEXT_PUBLIC_. NUNCA importar em componentes de cliente.
# Usada somente em rotas de servidor (app/api/**/route.ts) e Server Actions
# que precisem contornar RLS (ex.: criar usuário, tarefas administrativas).
SUPABASE_SERVICE_ROLE_KEY=

# Código secreto exigido para criar o PRIMEIRO gestor do sistema em /setup.
# Defina algo longo e aleatório (ex.: gerado com `openssl rand -hex 24`).
# Depois que o primeiro gestor for criado, a rota de setup se desativa
# sozinha — mas mantenha essa variável fora do repositório mesmo assim.
SETUP_ADMIN_SECRET=
